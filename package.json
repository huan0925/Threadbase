{
  "name": "threadbase",
  "version": "0.3.0",
  "private": true,
  "description": "Chrome extension that keeps all your AI chat history (ChatGPT, Claude, Gemini) searchable in one place, locally",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc",
    "test": "node --test \"test/*.test.ts\"",
    "test:e2e": "npm run build && node --test --test-concurrency=1 \"test/e2e/*.test.ts\""
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "1.56.1",
    "typescript": "~5.9.3"
  }
}
